#!/usr/bin/env bash
set -euo pipefail
wiki_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
generator=${DIAGRAM_GENERATOR_ROOT:-${HOME}/Projects/diagram-generator}
statechart=${STATECHART_GENERATOR_ROOT:-${HOME}/Projects/statechart-generator}
assets="$wiki_root/source/content/artifacts/research-architecture-and-statechart-atlas"
image=${DIAGRAM_GEN_IMAGE:-diagram-gen:local}
if docker info >/dev/null 2>&1; then engine=(docker); else engine=(sudo -n docker); fi
"${engine[@]}" image inspect "$image" >/dev/null
"${engine[@]}" run --rm --user "$(id -u):$(id -g)" --volume "$wiki_root:/workspace" \
  "$image" spec-batch --spec-dir source/content/artifacts/research-architecture-and-statechart-atlas/specs \
  --out-dir source/content/artifacts/research-architecture-and-statechart-atlas/rendered --format svg --format png
for file in "$assets"/specs/*.yaml; do cp "$file" "$file.txt"; done
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
for file in "$assets"/statecharts/*.txt; do cp "$file" "$work/$(basename "${file%.txt}")"; done
for variant in lifecycle lease-current lease-proposed; do
  case "$variant" in
    lifecycle) module=ResearchFlow; config=flow; view=flow-view; expected=0 ;;
    lease-current) module=LeaseFence; config=lease-current; view=lease-view; expected=1 ;;
    lease-proposed) module=LeaseFence; config=lease-proposed; view=lease-view; expected=0 ;;
  esac
  set +e
  "$statechart/scripts/statechart" "$work/$module.tla" --config "$work/$config.cfg" \
    --view "$work/$view.mjs" --out "$work/out-$variant"
  actual=$?
  set -e
  [[ "$actual" == "$expected" ]] || { echo "Unexpected verdict: $variant returned $actual" >&2; exit 1; }
  "$statechart/scripts/render" "$work/out-$variant/chart.mmd"
  # Screenshot Pele's SVG with the already provisioned diagram container browser.
  "${engine[@]}" run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
    --volume "$work:$work" --volume "$statechart/scripts:$statechart/scripts:ro" \
    --entrypoint node ghcr.io/mermaid-js/mermaid-cli/mermaid-cli:11.16.0 \
    "$statechart/scripts/screenshot.cjs" "$work/out-$variant/chart.svg"
  destination="$assets/statecharts/$variant"
  cp "$work/out-$variant/chart.mmd" "$destination/chart.mmd.txt"
  cp "$work/out-$variant/report.md" "$destination/report.md.txt"
  cp "$work/out-$variant/"{chart.svg,chart.png} "$destination/"
  sed "s|$HOME|/home/ACCOUNT_NAME|g" "$work/out-$variant/tlc.out" > "$destination/tlc.out"
done

python3 - "$assets/statecharts" <<'PY_NORMALIZE'
from pathlib import Path
import sys
for p in Path(sys.argv[1]).rglob('tlc.out'):
    p.write_text(p.read_text().rstrip() + '\n')
PY_NORMALIZE
