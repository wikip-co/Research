[Unit]
Description=Research project wiki (localhost only)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/Research/wiki
ExecStart=/usr/bin/python3 -m http.server 4010 --bind 127.0.0.1 --directory %h/Projects/Research/wiki/docs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
