# Docker Compose settings. Copy to .env and adjust for your host.
WIKI_BIND_ADDRESS=127.0.0.1
WIKI_PORT=8080
# For private-LAN access, set WIKI_BIND_ADDRESS to the host's actual LAN IP.
# Set source/_config.yml's url to the address readers will use, then rebuild.
# Optional, used only with compose.build-ca.yml:
# WIKI_BUILD_CA_FILE=/absolute/path/to/company-root-ca.pem
