// Home dashboard, article metadata, index tree metadata, article table and
// badges. Colors follow _variables.styl.

color-new = #2e8540
color-updated = #1f7ab8
color-moved = #8a5cb8
color-removed = #b04a3f
color-stale = #a86500
color-muted = #7b848c

// Shared building blocks

// Components below set display values that would otherwise override [hidden].
[hidden]
    display: none !important

.wiki-panel
    @extend $block
    background: #fff
    border: 1px solid #bbb
    border-radius: 4px
    padding: 0 20px 20px
    margin-bottom: 20px

.wiki-panel-header
    display: flex
    align-items: baseline
    justify-content: space-between
    gap: 10px
    margin: 0 -20px 15px
    padding: 10px 20px
    border-bottom: 1px solid color-border
    h1, h2
        margin: 0
        font-size: 1.25em
        font-weight: bold
        color: color-default
        .fa
            color: color-muted
            margin-right: 4px
    a
        font-size: 0.9em
        white-space: nowrap

.wiki-panel-note
    font-size: 0.9em
    color: color-muted

.wiki-empty
    color: color-grey
    font-style: italic

.wiki-button
    margin-top: 12px
    padding: 6px 14px
    border: 1px solid color-border-stretch
    border-radius: 15px
    background: color-background
    color: color-default
    font: inherit
    cursor: pointer
    &:hover,
    &:focus-visible
        background: color-link
        border-color: color-link
        color: #fff

.fresh-badge,
.status-badge,
.change-badge
    display: inline-block
    padding: 0 6px
    border-radius: 3px
    font-size: 11px
    font-weight: bold
    line-height: 17px
    letter-spacing: 0.02em
    text-transform: uppercase
    vertical-align: middle
    white-space: nowrap

.fresh-badge
    color: #fff
    &.fresh-new
        background: color-new
    &.fresh-updated
        background: color-updated

.status-badge
    color: color-default
    background: #e9ecef
    border: 1px solid #cfd4d9
    &.status-local
        color: #fff
        background: color-stale
        border-color: color-stale

time[title]
    cursor: help

// Widget title bar link (next to Index / Keywords)

.widget-wrap h3 .widget-link
    float: none
    position: relative
    top: 1px
    margin-top: 0
    color: color-link
    text-transform: none
    &[aria-current="page"]
        font-weight: bold

// Index tree metadata and controls

.index-controls
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px 12px
    margin-bottom: 12px
    text-shadow: none

.index-filter
    flex: 1 1 240px
    padding: 6px 8px
    border: 1px solid #ddd
    border-radius: 4px
    font: font-size font-sans
    color: color-default

.index-sort
    font-size: 13px
    color: color-muted
    select
        margin-left: 4px
        padding: 4px
        font: inherit
        color: color-default

.index-summary
    font-size: 13px
    color: color-muted

.index-empty
    color: color-grey
    font-style: italic

#categories
    li.directory > button
        display: flex
        align-items: center
        gap: 6px
        .tree-name
            flex: 1 1 auto
    li.file
        display: flex
        align-items: center
        gap: 8px
        & > a
            flex: 1 1 auto
            min-width: 0
    .tree-meta
        display: inline-flex
        align-items: center
        gap: 6px
        flex: 0 0 auto
        font-weight: normal
    .tree-count
        min-width: 18px
        padding: 0 5px
        border-radius: 9px
        background: #e9ecef
        color: color-muted
        font-size: 11px
        text-align: center
    .tree-date
        min-width: 32px
        color: color-grey
        font-size: 12px
        text-align: right
    .fresh-badge,
    .status-badge
        font-size: 10px
        line-height: 15px

// Search

.search-help
    margin: -4px 0 10px
    color: color-muted
    font-size: 12px
    code
        font-size: 11px

.search-summary
    margin: 8px 10px 0
    color: color-muted
    font-size: 12px

#local-search-result
    mark
        background: #fff1a8
        color: inherit
        padding: 0 1px
        border-radius: 2px

.search-result-list
    li
        padding-bottom: 10px
        border-bottom: 1px solid #f0f0f0
        &:last-child
            border-bottom: 0

.search-result-title:focus-visible
    outline: 2px solid color-link
    outline-offset: 2px

.search-result-meta
    span + span::before
        content: " · "
        color: color-grey
    .categories::before,
    .tags::before
        content: none
        margin-left: 0
    span + .tags::before
        content: " · "

.search-result-section
    display: inline-block
    margin-top: 4px
    font-size: 0.9em

.search-result-snippet
    margin: 4px 0 0
    color: color-default
    font-size: 0.95em
    line-height: 1.5

// Home dashboard

.home
    margin: 0 0 block-margin

.home-stats
    display: grid
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr))
    gap: 12px
    margin-bottom: 20px

.home-stat
    @extend $block
    padding: 12px 16px
    border: 1px solid #bbb
    border-radius: 4px
    background: #fff
    strong
        display: block
        font-size: 1.6em
        line-height: 1.3
        color: color-default
        time
            font-size: 0.8em
    span
        color: color-muted
        font-size: 0.9em

.home-grid
    display: grid
    grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr)
    gap: 20px
    align-items: start
    @media screen and (max-width: 799px)
        grid-template-columns: minmax(0, 1fr)

.last-visit
    margin: 0 0 10px
    padding: 6px 10px
    border-left: 3px solid color-updated
    background: #f1f7fc
    font-size: 0.9em

.change-filters
    display: flex
    flex-wrap: wrap
    gap: 6px
    margin-bottom: 10px
    button
        padding: 3px 12px
        border: 1px solid color-border-stretch
        border-radius: 15px
        background: #fff
        color: color-default
        font: inherit
        font-size: 0.9em
        cursor: pointer
        &[aria-pressed="true"]
            background: color-meta-head
            border-color: color-meta-head
            color: #fff
        &:focus-visible
            outline: 2px solid color-link
            outline-offset: 1px

.change-days,
.change-commits,
.change-files,
.folder-list,
.folder-sublist,
.article-list
    list-style: none
    margin: 0
    padding: 0

.change-day
    h3
        margin: 18px 0 6px
        padding-bottom: 4px
        border-bottom: 1px solid color-border
        color: color-muted
        font-size: 0.85em
        font-weight: bold
        text-transform: uppercase
        letter-spacing: 0.04em

.change-commit
    margin: 0 0 8px
    padding: 6px 10px
    border-left: 3px solid color-border
    &.is-unseen
        border-left-color: color-updated
        background: #f1f7fc

.change-commit-header
    display: flex
    flex-wrap: wrap
    justify-content: space-between
    gap: 2px 12px
    margin-bottom: 4px

.change-subject
    font-weight: bold
    color: color-default

.change-commit-meta
    color: color-grey
    font-size: 0.85em
    white-space: nowrap
    code
        margin: 0
        padding: 0 3px
        font-size: 0.95em

.change
    display: flex
    flex-wrap: wrap
    align-items: baseline
    gap: 2px 8px
    padding: 2px 0

.change-badge
    min-width: 62px
    text-align: center
    color: #fff
    background: color-updated

.change-added .change-badge
    background: color-new

.change-moved .change-badge,
.change-renamed .change-badge
    background: color-moved

.change-deleted .change-badge
    background: color-removed

.change-title-gone
    color: color-grey
    text-decoration: line-through

.change-folder
    color: color-grey
    font-size: 0.85em

.folder-list > li
    padding: 8px 0
    border-bottom: 1px solid #f0f0f0
    &:last-child
        border-bottom: 0

.folder-list-title
    display: flex
    align-items: center
    gap: 6px
    a
        font-weight: bold

.folder-list-meta
    color: color-grey
    font-size: 0.85em

.folder-sublist
    margin: 4px 0 0 12px
    font-size: 0.9em

// Article metadata and footer

.article-info
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 4px 16px
    margin: -4px 0 14px
    color: color-muted
    font-size: 0.9em
    .fa
        margin-right: 2px
    a
        color: color-link

.article-last-change
    flex-basis: 100%

.article-description
    margin: 0 0 14px
    font-size: 1.1em
    line-height: 1.5
    color: color-default

.stale-notice
    margin: 0 0 14px
    padding: 8px 12px
    border-left: 4px solid color-stale
    background: #fff6e5
    color: #6b4300

.article-footer-nav
    display: grid
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr))
    gap: 10px 30px
    margin: 20px 0 0
    padding: 10px article-padding 20px
    border-top: 1px solid color-border
    background: #fafbfc
    h2
        margin: 10px 0 8px
        font-size: 1em
        font-weight: bold
        color: color-default

.article-list
    li
        padding: 4px 0
        line-height: 1.4

.article-list-meta
    display: block
    color: color-grey
    font-size: 0.85em

// Category and tag pages

.timeline-row .content
    h1 .fresh-badge,
    h1 .status-badge
        margin-left: 6px
    .timeline-description
        margin: 0
        padding: 0 10px 10px
        color: color-default
        line-height: 1.5
    .article-meta > div
        float: none

// All articles table

.article-table-controls
    display: flex
    margin-bottom: 10px

.article-table-scroll
    overflow-x: auto

.article-table
    width: 100%
    border-collapse: collapse
    font-size: 0.95em
    th, td
        padding: 8px 10px
        border-bottom: 1px solid color-border
        text-align: left
        vertical-align: top
    th
        position: sticky
        top: 0
        background: #f4f6f7
        white-space: nowrap
        button
            padding: 0
            border: 0
            background: none
            color: color-default
            font: inherit
            font-weight: bold
            cursor: pointer
            &::after
                content: " \f0dc"
                font-family: FontAwesome
                color: #c1c7cd
        &[aria-sort="ascending"] button::after
            content: " \f0de"
            color: color-default
        &[aria-sort="descending"] button::after
            content: " \f0dd"
            color: color-default
    td
        time
            white-space: nowrap
    tbody tr:hover
        background: #f8fafb
    .numeric
        text-align: right
    .fresh-badge,
    .status-badge
        margin-left: 4px

.article-table-tags,
.article-table-folder
    color: color-grey
    font-size: 0.85em

// Footer

#footer-info
    display: flex
    flex-wrap: wrap
    justify-content: space-between
    gap: 6px 20px
    padding: 0 0 30px
    color: color-muted
    font-size: 0.85em
    a
        margin-left: 4px
