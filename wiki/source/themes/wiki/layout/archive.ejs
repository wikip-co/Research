<%
    const catalog = wiki_catalog();
    const articles = page.posts.map(function (post) { return wiki_article(post); }).filter(Boolean)
        .sort(function (a, b) { return String(b.updated).localeCompare(String(a.updated)); });
    let heading = 'All articles';
    if (page.year && page.month) heading = 'Articles created in ' + date(new Date(page.year, page.month - 1, 1), 'MMMM YYYY');
    else if (page.year) heading = 'Articles created in ' + page.year;
%>
<section class="wiki-panel article-table-panel" aria-labelledby="archive-title">
    <header class="wiki-panel-header">
        <h1 id="archive-title"><%= heading %></h1>
        <span class="wiki-panel-note"><span data-table-count><%= articles.length %></span> of <%= articles.length %> articles<% if (articles.length !== catalog.articles.length) { %> (<a href="<%- url_for(config.archive_dir + '/') %>">show all <%= catalog.articles.length %></a>)<% } %></span>
    </header>
    <div class="article-table-controls">
        <label class="screen-reader-text" for="article-table-filter">Filter articles</label>
        <input id="article-table-filter" type="search" class="index-filter" placeholder="Filter by title, folder, tag or status..." autocomplete="off">
    </div>
    <div class="article-table-scroll">
        <table class="article-table" data-sortable>
            <thead>
                <tr>
                    <th scope="col" data-sort="text"><button type="button">Title</button></th>
                    <th scope="col" data-sort="text"><button type="button">Folder</button></th>
                    <th scope="col" data-sort="text" aria-sort="descending"><button type="button">Updated</button></th>
                    <th scope="col" data-sort="text"><button type="button">Created</button></th>
                    <th scope="col" data-sort="number" class="numeric"><button type="button">Revisions</button></th>
                    <th scope="col" data-sort="number" class="numeric"><button type="button">Words</button></th>
                </tr>
            </thead>
            <tbody>
                <% articles.forEach(function (article) { %>
                    <tr data-search="<%= [article.title, article.categories.join(' '), article.tags.join(' '), article.status].join(' ').toLowerCase() %>">
                        <td data-value="<%= article.title.toLowerCase() %>">
                            <a href="<%- article.href %>"><%= article.title %></a>
                            <span class="fresh-badge" data-created="<%= article.created %>" data-updated="<%= article.updated %>" hidden></span>
                            <% if (article.status) { %><span class="status-badge"><%= article.status %></span><% } %>
                            <% if (article.tags.length) { %><div class="article-table-tags"><%= article.tags.join(', ') %></div><% } %>
                        </td>
                        <td data-value="<%= article.categories.join('/').toLowerCase() %>">
                            <% if (article.category_href) { %><a class="article-table-folder" href="<%- article.category_href %>"><%= article.categories.join(' › ') %></a><% } %>
                        </td>
                        <td data-value="<%= article.updated %>"><%- wiki_time(article.updated, { relative: 'append' }) %></td>
                        <td data-value="<%= article.created %>"><%- wiki_time(article.created, { relative: false }) %></td>
                        <td data-value="<%= article.revisions %>" class="numeric"><%= article.revisions %></td>
                        <td data-value="<%= article.words %>" class="numeric"><%= article.words.toLocaleString('en-US') %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</section>
