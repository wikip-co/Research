<%
    const headArticle = is_post() ? wiki_article(page) : null;
    const pageDescription = headArticle && headArticle.description ? headArticle.description : config.description;
%>
<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= pageDescription %>">
    <title><%= page.title ? `${page.title} | ${config.title}` : config.title %></title>

    <link href="<%- url_for(site.data.resources.favicon) %>" rel="icon">
    <link href="<%- full_url_for(page.path) %>" rel="canonical">
    <link href="<%- url_for('changes.xml') %>" rel="alternate" type="application/atom+xml" title="<%= config.title %>: recent changes">
    <link href="<%- url_for('llms.txt') %>" rel="alternate" type="text/plain" title="Article index for agents">
    <% if (headArticle) { %>
        <link href="<%- headArticle.markdown_href %>" rel="alternate" type="text/markdown" title="Markdown source with metadata">
        <meta property="article:modified_time" content="<%= headArticle.updated %>">
    <% } %>

    <link rel="stylesheet" href="<%- url_for('css/style.css') %>">
    <link rel="stylesheet" href="<%- url_for('libs/font-awesome/css/font-awesome.min.css') %>">
</head>
