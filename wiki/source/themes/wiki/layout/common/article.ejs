<%
    const historyEnabled = theme.history_control && theme.history_control.enable;
    const resources = site.data.resources || {};
    const newArticleUrl = repository_new_file_url(resources.new_post_directory);
    const editUrl = repository_content_url('edit', post.source);
    const historyUrl = repository_content_url('commits', post.source);
    const sourceUrl = repository_content_url('raw', post.source);
    const imageUrl = article_image_url(post);
    const imageAlt = typeof post.image_alt === 'string' ? post.image_alt : '';
    const outline = toc(post.content, { min_depth: 2, max_depth: 4 });
    const article = wiki_article(post);
    const catalog = wiki_catalog();
    const freshness = theme.freshness || {};
    const repositoryUrl = String(resources.repository_url || '').replace(/\/+$/, '');

    let siblings = [];
    let backlinks = [];
    let related = [];
    let scopeName = '';
    if (article) {
        const scope = article.project ? ['Active Projects', article.project] : article.categories;
        scopeName = scope.length ? scope[scope.length - 1] : '';
        if (scope.length) {
            const prefix = scope.join('/') + '/';
            siblings = catalog.articles.filter(function (other) {
                return other !== article && (other.categories.join('/') + '/').indexOf(prefix) === 0;
            }).sort(function (a, b) {
                return Number(b.overview) - Number(a.overview) || String(b.updated).localeCompare(String(a.updated));
            });
        }
        const shown = new Set(siblings.map(function (other) { return other.path; }));
        backlinks = article.backlinks.map(function (path) { return catalog.byPath.get(path); }).filter(Boolean);
        backlinks.forEach(function (other) { shown.add(other.path); });
        related = article.related.filter(function (path) { return !shown.has(path); })
            .map(function (path) { return catalog.byPath.get(path); }).filter(Boolean).slice(0, 5);
    }

    function articleItem(other) {
        return '<li><a href="' + other.href + '">' + escape_html(other.title) + '</a> <span class="article-list-meta">'
            + (other.overview ? 'overview · ' : '') + (other.status ? escape_html(other.status) + ' · ' : '')
            + 'updated ' + wiki_time(other.updated) + '</span></li>';
    }
%>
<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %>" itemscope itemtype="https://schema.org/Article">
    <div class="article-inner">
        <header class="article-header">
            <div class="article-meta">
                <%- partial('post/cat') %>
            </div>
            <% if (historyEnabled && editUrl && historyUrl && sourceUrl) { %>
                <nav class="article-actions" aria-label="Article actions">
                    <% if (newArticleUrl) { %>
                        <a href="<%= newArticleUrl %>" target="_blank" rel="noopener">New</a>
                    <% } %>
                    <a href="<%= editUrl %>" target="_blank" rel="noopener">Edit</a>
                    <a href="<%= historyUrl %>" target="_blank" rel="noopener">History</a>
                    <a href="<%= sourceUrl %>" target="_blank" rel="noopener">Source</a>
                    <% if (article) { %>
                        <a href="<%- article.markdown_href %>" title="Markdown with metadata, for agents and copy/paste" type="text/markdown">Markdown</a>
                    <% } %>
                </nav>
            <% } %>
            <h1 class="article-title" itemprop="headline"><%= post.title %></h1>
            <% if (article) { %>
                <div class="article-info">
                    <% if (article.status) { %><span class="status-badge"><%= article.status %></span><% } %>
                    <span class="fresh-badge" data-created="<%= article.created %>" data-updated="<%= article.updated %>" hidden></span>
                    <% if (article.uncommitted) { %><span class="status-badge status-local" title="Shown only in local previews">Uncommitted changes</span><% } %>
                    <span><i class="fa fa-pencil" aria-hidden="true"></i> Updated <%- wiki_time(article.updated, { relative: 'append' }) %><meta itemprop="dateModified" content="<%= article.updated %>"></span>
                    <span><i class="fa fa-calendar-plus-o" aria-hidden="true"></i> Created <%- wiki_time(article.created, { relative: false }) %><meta itemprop="dateCreated" content="<%= article.created %>"></span>
                    <% if (article.revisions) { %>
                        <span><i class="fa fa-history" aria-hidden="true"></i> <% if (historyUrl) { %><a href="<%= historyUrl %>" target="_blank" rel="noopener"><% } %><%= article.revisions %> revision<%= article.revisions === 1 ? '' : 's' %><% if (historyUrl) { %></a><% } %></span>
                    <% } %>
                    <span><i class="fa fa-clock-o" aria-hidden="true"></i> <%= article.reading_minutes %> min read</span>
                    <% if (article.last_commit) { %>
                        <span class="article-last-change"><i class="fa fa-code-fork" aria-hidden="true"></i> Last change:
                            <% if (repositoryUrl) { %><a href="<%= repositoryUrl %>/commit/<%= article.last_commit.hash %>" target="_blank" rel="noopener"><%= article.last_commit.subject %></a><% } else { %><%= article.last_commit.subject %><% } %>
                        </span>
                    <% } %>
                </div>
                <% if (article.has_description) { %>
                    <p class="article-description" itemprop="description"><%= article.description %></p>
                <% } %>
                <p class="stale-notice" data-updated="<%= article.updated %>" data-stale-days="<%= freshness.stale_days || 180 %>" hidden>
                    <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                    This article has not been updated for <span data-stale-age></span>. Verify time-sensitive facts before relying on them.
                </p>
            <% } %>
            <% if (imageUrl) { %>
                <img class="article-image" src="<%= imageUrl %>" alt="<%= imageAlt %>" width="200" decoding="async">
            <% } %>
            <% if ((post.tags && post.tags.length) || outline) { %>
                <aside class="article-summary" aria-label="Article summary">
                    <% if (post.tags && post.tags.length) { %>
                        <h2>Keywords</h2>
                        <%- list_tags(post.tags, { show_count: false, style: 'link', separator: ', ' }) %>
                    <% } %>
                    <% if (outline) { %>
                        <h2>Outline</h2>
                        <nav aria-label="Table of contents"><%- outline %></nav>
                    <% } %>
                </aside>
            <% } %>
        </header>
        <div class="article-entry" itemprop="articleBody">
            <%- post.content %>
        </div>
        <% if (siblings.length || backlinks.length || related.length) { %>
            <footer class="article-footer-nav" aria-label="Related articles">
                <% if (siblings.length) { %>
                    <section>
                        <h2>More in <%= scopeName %></h2>
                        <ul class="article-list"><% siblings.forEach(function (other) { %><%- articleItem(other) %><% }); %></ul>
                    </section>
                <% } %>
                <% if (backlinks.length) { %>
                    <section>
                        <h2>Referenced by</h2>
                        <ul class="article-list"><% backlinks.forEach(function (other) { %><%- articleItem(other) %><% }); %></ul>
                    </section>
                <% } %>
                <% if (related.length) { %>
                    <section>
                        <h2>Related</h2>
                        <ul class="article-list"><% related.forEach(function (other) { %><%- articleItem(other) %><% }); %></ul>
                    </section>
                <% } %>
            </footer>
        <% } %>
    </div>
</article>
