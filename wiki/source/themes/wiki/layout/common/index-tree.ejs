<%
    const catalog = wiki_catalog();
    const perExpand = Boolean(theme.customize.category_perExpand);
    const currentPath = is_post() ? page.path : null;

    function byName(a, b) {
        return a.name.localeCompare(b.name);
    }
    function containsCurrent(folder) {
        return Boolean(currentPath) && (folder.articles.some(function (article) { return article.path === currentPath; })
            || Array.from(folder.children.values()).some(containsCurrent));
    }
    function searchText(article) {
        return [article.title, article.tags.join(' '), article.status].join(' ').toLowerCase();
    }
%>
<div class="index-controls">
    <label class="screen-reader-text" for="index-filter">Filter the index</label>
    <input id="index-filter" type="search" class="index-filter" placeholder="Filter folders and articles..." autocomplete="off">
    <label class="index-sort">
        <span>Sort</span>
        <select id="index-sort">
            <option value="name">A–Z</option>
            <option value="updated">Recently updated</option>
        </select>
    </label>
    <span class="index-summary"><%= catalog.articles.length %> articles</span>
</div>
<% function renderFolder(node) { %>
    <ul class="unstyled category-tree">
        <% Array.from(node.children.values()).sort(byName).forEach(function (folder) {
            const open = perExpand || containsCurrent(folder); %>
            <li class="directory<%- open ? ' open' : '' %>" data-name="<%= folder.name %>" data-updated="<%= folder.updated %>" data-search="<%= folder.key.toLowerCase() %>">
                <button type="button" data-role="directory" aria-expanded="<%= open %>">
                    <i class="fa fa-folder<%- open ? '-open' : '' %>" aria-hidden="true"></i>
                    <span class="tree-name"><%= folder.name %></span>
                    <span class="tree-meta">
                        <span class="tree-count" title="<%= folder.count %> article(s)"><%= folder.count %></span>
                        <%- wiki_time(folder.updated, { class: 'tree-date', relative: 'short' }) %>
                    </span>
                </button>
                <% renderFolder(folder) %>
            </li>
        <% }); %>
        <% node.articles.slice().sort(function (a, b) { return a.title.localeCompare(b.title); }).forEach(function (article) { %>
            <li class="file<%- article.path === currentPath ? ' active' : '' %>" data-name="<%= article.title %>" data-updated="<%= article.updated %>" data-search="<%= searchText(article) %>">
                <a href="<%- article.href %>"<%- article.path === currentPath ? ' aria-current="page"' : '' %>><%= article.title %></a>
                <span class="tree-meta">
                    <span class="fresh-badge" data-created="<%= article.created %>" data-updated="<%= article.updated %>" hidden></span>
                    <% if (article.status) { %><span class="status-badge"><%= article.status %></span><% } %>
                    <%- wiki_time(article.updated, { class: 'tree-date', relative: 'short' }) %>
                </span>
            </li>
        <% }); %>
    </ul>
<% } %>
<% renderFolder(catalog.folders); %>
<p class="index-empty" hidden>No folders or articles match the filter.</p>
