#!/usr/bin/env bash
set -euo pipefail

diagram_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
research_root="$(cd -- "${diagram_root}/../.." && pwd)"
generator_root="${DIAGRAM_GENERATOR_ROOT:-${HOME}/diagram-generator}"
generator_image="${DIAGRAM_GENERATOR_IMAGE:-diagram-gen:local}"
spec_root="${diagram_root}/specs"
render_root="${diagram_root}/rendered"
container_engine="${CONTAINER_ENGINE:-}"

if [[ ! -x "${generator_root}/scripts/build-container.sh" ]]; then
  printf 'diagram-generator not found or incomplete: %s\n' "$generator_root" >&2
  exit 1
fi

if [[ -z "$container_engine" ]]; then
  if command -v podman >/dev/null 2>&1; then
    container_engine=podman
  elif command -v docker >/dev/null 2>&1; then
    container_engine=docker
  else
    printf 'Neither Podman nor Docker is available.\n' >&2
    exit 1
  fi
fi

case "$container_engine" in
  podman|docker) ;;
  *) printf 'Unsupported container engine: %s\n' "$container_engine" >&2; exit 1 ;;
esac

if ! "$container_engine" image inspect "$generator_image" >/dev/null 2>&1; then
  (
    cd "$generator_root"
    CONTAINER_ENGINE="$container_engine" ./scripts/build-container.sh
  )
fi

mkdir -p "$render_root"

run_args=(run --rm)
if [[ "$container_engine" == podman ]]; then
  run_args+=(--userns=keep-id --volume "${research_root}:/workspace:Z")
else
  run_args+=(--user "$(id -u):$(id -g)" --volume "${research_root}:/workspace")
fi

"$container_engine" "${run_args[@]}" "$generator_image" spec-batch \
  --spec-dir /workspace/docs/diagrams/specs \
  --out-dir /workspace/docs/diagrams/rendered \
  --format svg --format png

printf 'Rendered %s specs into %s with %s image %s\n' \
  "$(find "$spec_root" -maxdepth 1 -name '*.yaml' | wc -l)" \
  "$render_root" "$container_engine" "$generator_image"
